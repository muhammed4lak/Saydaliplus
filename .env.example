# Copy to .env.local and fill in.

# Supabase project — Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-side only, never exposed to the browser, and used
# in exactly one place: the student email-confirmation callback, which has to
# verify a profile before anyone is signed in as that student.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the email confirmation redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments. Leave unset to use the mock provider; there is no real
# implementation yet, and there will not be one until the merchant agreements
# are signed. See src/lib/payments/provider.ts.
# PAYMENTS_PROVIDER=zaincash

# For the CV assistant. Server-side only — this key must never reach a browser.
ANTHROPIC_API_KEY=
